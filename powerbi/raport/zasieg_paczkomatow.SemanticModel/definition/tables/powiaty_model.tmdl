	partition powiaty_model = m
		mode: import
		source =
				let
				    Plik = Folder & "powiaty_model.parquet",
				    Zawartosc = if Text.StartsWith(Folder, "http") then Web.Contents(Plik) else File.Contents(Plik),
				    Zrodlo = Parquet.Document(Binary.Buffer(Zawartosc)),
				    Typy = Table.TransformColumnTypes(Zrodlo, {{"powiat_id", Int64.Type}})
				in
				    Typy

