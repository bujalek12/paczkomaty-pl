	column miejsce_w_kraju
		dataType: int64
		lineageTag: 2b99ac67-30e5-4a76-9e08-d2caee9ee81f
		summarizeBy: none
		sourceColumn: miejsce_w_kraju

	column 'Oczekiwany zasięg 500 m' =
			    VAR prosta =
			        LINESTX (
			            FILTER ( ALL ( powiaty ), NOT powiaty[dane_niepewne] ),
			            powiaty[udzial_500m],
			            powiaty[udzial_miejski]
			        )
			    VAR a = MAXX ( prosta, [Slope1] )
			    VAR b = MAXX ( prosta, [Intercept] )
			    RETURN
			        a * powiaty[udzial_miejski] + b
		dataType: double
		lineageTag: 600e630d-8449-4e7a-94c5-605c83f0fdfe
		summarizeBy: none
		formatString: 0.0%

	column 'Różnica do oczekiwanego (pp)' =
			    ( powiaty[udzial_500m] - powiaty[Oczekiwany zasięg 500 m] ) * 100
		dataType: double
		lineageTag: f43f60df-05d6-4e64-8c0a-35eef90e116d
		summarizeBy: none
		formatString: +0;-0;0

	column 'Klasa zasięgu' =
			    SWITCH (
			        TRUE (),
			        powiaty[udzial_500m] < 0.20, "1. poniżej 20%",
			        powiaty[udzial_500m] < 0.35, "2. 20–35%",
			        powiaty[udzial_500m] < 0.55, "3. 35–55%",
			        powiaty[udzial_500m] < 0.70, "4. 55–70%",
			        "5. powyżej 70%"
			    )
		dataType: string
		lineageTag: 6736ae65-a79c-43a7-8ea6-74bc3e7564fa
		summarizeBy: none

	partition powiaty = m
		mode: import
		source =
				let
				    Plik = Folder & "powiaty.parquet",
				    Zawartosc = if Text.StartsWith(Folder, "http") then Web.Contents(Plik) else File.Contents(Plik),
				    Zrodlo = Parquet.Document(Binary.Buffer(Zawartosc))
				in
				    Zrodlo

